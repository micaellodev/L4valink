// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  WORKER
}

enum QueueStatus {
  PENDING
  APPROVED
  PLAYING
  FINISHED
  REJECTED
}

model User {
  id            String   @id @default(cuid())
  username      String   @unique
  password      String   // Hashed with bcrypt
  role          UserRole @default(WORKER)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model QueueItem {
  id              String      @id @default(cuid())
  youtubeId       String      @map("youtube_id")
  title           String
  channelTitle    String      @map("channel_title")
  duration        String
  requestedByTable Int        @map("requested_by_table")
  requestedBy      String?    @map("requested_by")
  comments        String?     // Optional special requests from customers
  status          QueueStatus @default(PENDING)
  order           Int         @default(0)
  createdAt       DateTime    @default(now()) @map("created_at")
  playedAt        DateTime?   @map("played_at")

  @@index([status, order])
  @@map("queue_items")
}

model TableSession {
  id          Int      @id @default(autoincrement())
  tableNumber Int      @unique @map("table_number")
  userName    String   @map("user_name")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("table_sessions")
}

model TableLog {
  id          Int      @id @default(autoincrement())
  tableNumber Int      @map("table_number")
  customerName String  @map("customer_name")
  openedAt    DateTime @default(now()) @map("opened_at")
  closedAt    DateTime? @map("closed_at")
  openedBy    String   @default("System") @map("opened_by") 
  closedBy    String?  @map("closed_by")
  totalTotal  Float?   @map("total_total")
  
  @@map("table_logs")
}

model Settings {
  id            String   @id @default(cuid())
  venueName     String   @default("Karaoke Venue") @map("venue_name")
  isSystemLocked Boolean @default(false) @map("is_system_locked")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model Order {
  id          String   @id @default(cuid())
  tableNumber Int      @map("table_number")
  userName    String?  @map("user_name") // Name of the customer who placed the order
  workerName  String?  @map("worker_name") // Name of the worker who took the order (optional)
  items       Json     // Array of { name: string, quantity: number }
  totalPrice  Float    @default(0) @map("total_price") // Total price in soles
  status      String   @default("PENDING") // PENDING, COMPLETED
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("orders")
}

// ─────────────────────────────────────────────
//  INVENTORY MODULE
// ─────────────────────────────────────────────

model InventoryProduct {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  dailyEntries DailyInventoryEntry[]

  @@map("inventory_products")
}

model DailyInventoryEntry {
  id          String   @id @default(cuid())
  date        DateTime @db.Date // Date of the inventory day
  milliliters Float    @default(0) // Amount in ml
  quantity    Int      @default(0) // Number of units
  submittedBy String?  @map("submitted_by") // Username of worker who submitted
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  productId   String
  product     InventoryProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, date])
  @@index([date])
  @@map("daily_inventory_entries")
}

// ─────────────────────────────────────────────
//  MENU MODULE
// ─────────────────────────────────────────────

model MenuCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  items MenuItem[]

  @@map("menu_categories")
}

model MenuItem {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  imageUrl    String?  @map("image_url")
  isActive    Boolean  @default(true) @map("is_active")
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  categoryId String
  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  variants MenuItemVariant[]
  promotions PromotionItem[]

  @@index([categoryId])
  @@map("menu_items")
}

model MenuItemVariant {
  id          String   @id @default(cuid())
  name        String
  price       Float?
  imageUrl    String?  @map("image_url")
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  menuItemId  String
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId])
  @@map("menu_item_variants")
}

// ─────────────────────────────────────────────
//  PROMOTIONS MODULE
// ─────────────────────────────────────────────

model Promotion {
  id          String   @id @default(cuid())
  title       String
  description String?
  price       Float?
  quantity    Int      @default(1) // cuántos items puede elegir el cliente
  imageUrl    String?  @map("image_url")
  isActive    Boolean  @default(true) @map("is_active")
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  items       PromotionItem[]

  @@index([isActive])
  @@map("promotions")
}

model PromotionItem {
  id           String   @id @default(cuid())
  promotionId  String   @map("promotion_id")
  promotion    Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  menuItemId   String   @map("menu_item_id")
  menuItem     MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([promotionId, menuItemId])
  @@index([promotionId])
  @@index([menuItemId])
  @@map("promotion_items")
}

