# ── Database ──
DATABASE_URL=postgresql://karaoke:karaoke@localhost:5432/karaoke?schema=public

# ── Auth ──
JWT_SECRET=change-me-in-production

# ── CORS ──
ALLOWED_ORIGINS=http://localhost:3000

# ── Port ──
PORT=3001

# ── Supabase Storage ──
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_STORAGE_BUCKET=your-bucket-name
SUPABASE_ACCESS_KEY_ID=your-s3-access-key-id
SUPABASE_SECRET_ACCESS_KEY=your-s3-secret-access-key
# Optional: explicit public URL for images (default: https://<project>.supabase.co/storage/v1/object/public/<bucket>)
# SUPABASE_PUBLIC_URL=https://xxxx.supabase.co/storage/v1/object/public/your-bucket-name
# Optional: explicit S3-compatible endpoint (default: https://<project>.storage.supabase.co/storage/v1/s3)
# SUPABASE_S3_ENDPOINT=https://xxxx.storage.supabase.co/storage/v1/s3
# Optional: Supabase project region (default: auto)
# SUPABASE_REGION=us-east-1

# ── YouTube Rescate Nodes (opcional, se usan los defaults si no se configuran) ──
# Lista actualizada de instancias públicas. Separa por comas sin espacios.
# INVIDIOUS_NODES=https://inv.zoomerville.com,https://inv.nadeko.net,https://invidious.nerdvpn.de,https://invidious.f5.si,https://yt.chocolatemoo53.com,https://invidious.tiekoetter.com
# PIPED_NODES=https://pipedapi.kavin.rocks,https://pipedapi.adminforge.de,https://api.piped.yt,https://pipedapi.leptons.xyz,https://pipedapi.nosebs.ru,https://pipedapi-libre.kavin.rocks,https://piped-api.privacy.com.de,https://pipedapi.drgns.space,https://pipedapi.owo.si,https://pipedapi.ducks.party,https://piped-api.codespace.cz,https://pipedapi.reallyaweso.me,https://api.piped.private.coffee,https://pipedapi.darkness.services,https://pipedapi.orangenet.cc

# ── YouTube Data API v3 (opcional, más estable que nodos públicos) ──
# Cómo obtener: https://console.cloud.google.com/apis/credentials
# Activa "YouTube Data API v3" y crea una API key.
# YOUTUBE_API_KEY=AIza...

# Modo estricto de verificación de videos.
# "true": rechaza videos si no se pueden verificar (requiere API key o nodos funcionando).
# "false": permite agregar videos sin verificar (por defecto, útil mientras los nodos públicos fallan).
# YOUTUBE_VERIFY_STRICT=false
